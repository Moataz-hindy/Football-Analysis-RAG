## ---- Week 1: Database & Embeddings ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=football_intelligence
DB_USER=postgres
DB_PASSWORD=your_password_here

# OpenRouter API key (used for embeddings in Week 1)
OPENAI_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-embedding-350m:free

## ---- Week 2: LLM Provider (Agent Framework) ----
# See docs/llm_provider.md for all supported providers
# Default: Groq (free tier, 1000 req/day, get key at console.groq.com)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
